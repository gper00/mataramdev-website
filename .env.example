# ============================================================
# Copy file ini ke .env.local, lalu ganti semua nilai placeholder-nya.
# Nilai mengandung "<" atau ">" dianggap placeholder oleh src/lib/env.ts,
# jadi aplikasi akan menolak jalan (503) sampai benar-benar diisi.
# ============================================================

# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Opsional — kode saat ini TIDAK membacanya; semua server action pakai sesi
# user + anon key. Isi hanya kalau nanti butuh operasi bypass RLS.
# ⚠️ Tanpa prefix NEXT_PUBLIC_: key ini tidak boleh sampai ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Hanya dipakai drizzle-kit (pnpm db:push / db:generate / db:studio).
# Aplikasi saat runtime tidak memakainya, jadi tidak perlu diset di Vercel.
#
# Untuk migrasi pakai SESSION POOLER (port 5432) — transaction pooler (6543)
# sering gagal untuk DDL multi-statement.
#
# Session pooler (pakai ini):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (kalau mesinmu punya IPv6):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# ============================================================
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
